{
  "private": true,
  "engines": {
    "node": ">= 16.20"
  },
  "devDependencies": {
    "chalk": "4.1.2",
    "zx": "7.2.3",
    "git-repo-info": "2.1.1",
    "esno": "4.0.0",
    "typescript": "4.2.4",
    "turbo": "^1.10.16",
    "dumi": "^2.2.13",
    "jumai-code-style": "workspace:*"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run changelog && git add . && lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS && validate-commit-msg"
    }
  },
  "lint-staged": {
    "**/*.less": [
      "npm run lint:style-less",
      "git add ."
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "npm run lint:js",
      "git add ."
    ],
    "**/*.{css,md,html,json}": [
      "prettier --write",
      "git add ."
    ]
  },
  "resolutions": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "release": "esno scripts/release.ts",
    "test": "turbo test",
    "build": "turbo build",
    "lint-staged": "lint-staged --allow-empty",
    "lint:style-less": "stylelint --cache --fix \"**/*.less\" --syntax less",
    "lint:js": "eslint --fix --cache --quiet --ext .js,.jsx,.ts,.tsx .",
    "prettier": "prettier --cache --cache-strategy metadata -c --write \"**/*.{css,md,html,json}\"",
    "docs:start": "dumi dev",
    "docs:build": "dumi build"
  }
}